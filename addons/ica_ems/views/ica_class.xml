<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="ica_class_view_tree" model="ir.ui.view">
        <field name="name">ica_class_view_tree</field>
        <field name="model">ica.class</field>
        <field name="arch" type="xml">
            <list string="ica_class_tree">
                <field name="reference"/>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="ica_class_view_form" model="ir.ui.view">
        <field name="name">ica_class_view_form_view_form</field>
        <field name="model">ica.class</field>
        <field name="arch" type="xml">
            <form string="ica_class_view_form_form">
                <header>
                    <button name="action_draft" type="object" string="Draft" invisible="state != 'not_available'"/>
                    <button name="action_generate_timetable" type="object" class="btn btn-primary"
                            string="Generate Timetable" invisible="state != 'draft' or timetable_ids"/>
                    <button name="action_confirmed" type="object" string="Confirm"
                            class="btn btn-primary" invisible="state != 'draft' or not timetable_ids"/>
                    <button name="action_available" type="object" string="Available" class="btn btn-primary"
                            invisible="state != 'confirmed'"/>
                    <button name="action_booking" type="object" string="Booking" class="btn btn-outline-info"
                            invisible="state != 'confirmed'"/>
                    <button name="action_not_available" type="object" string="Not Available" class="btn btn-danger"
                            invisible="state != 'available'"
                            confirm="Are you sure?"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button"
                                name="action_view_timetable"
                                type="object"
                                icon="fa-sitemap"
                                string="Timetable">
                            <field name="remain_timetable_count"/>
                            <sppan> Timetable</sppan>
                        </button>
                        <button class="oe_stat_button"
                                name="action_view_students"
                                type="object"
                                icon="fa-address-book"
                                string="Students">
                            <field name="total_student_count"/>
                            <sppan> Students</sppan>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="reference"/>
                        <h1><field name="reference" placeholder="e.g. IC/000000"/></h1>
                    </div>

                    <group>
                        <group>
                            <field name="name"/>
                            <field name="reference"/>
                            <field name="employee_id"/>
                            <field name="is_in_person"/>
                            <field name="is_online"/>
                        </group>
                        <group>
                            <field name="start_datetime"/>
                            <field name="duration"/>
                            <field name="start_datetime" widget="daterange"
                                   options="{'end_date_field': 'end_datetime'}"/>
                            <field name="end_datetime" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Weekly Information">
                            <field name="is_mon"/>
                            <field name="is_tue"/>
                            <field name="is_wed"/>
                            <field name="is_thu"/>
                            <field name="is_fri"/>
                            <field name="is_sat"/>
                            <field name="is_sun"/>
                        </group>
                        <group string="Invoice Information">
                            <field name="company_id"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="fees" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Timetables">
                            <field name="timetable_ids" readonly="state != 'draft'">
                                <list>
                                    <field name="start_datetime"/>
                                    <field name="end_datetime"/>
                                    <field name="state" widget="badge" decoration-danger="state == 'cancelled'"
                                           decoration-success="state =='finished'"/>
                                    <button name="action_finish" type="object" class="btn btn-success" string="Finish"
                                            invisible="state != 'draft'"/>
                                    <button name="action_cancel" type="object" class="btn btn-warning" string="Cancel"
                                            invisible="state != 'draft'"/>
                                </list>
                            </field>
                        </page>
                        <page name="Students">
                            <field name="student_ids" readonly="1">
                                <list editable="top">
                                    <field name="partner_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ica_class_action" model="ir.actions.act_window">
        <field name="name">Class</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ica.class</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>