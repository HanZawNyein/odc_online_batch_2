<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Inherit Form View to Modify it -->
    <record id="view_employee_form" model="ir.ui.view">
        <field name="name">view_employee_form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <div name="button_box" class="oe_button_box" position="inside">
                <button name="%(ica_ems.ica_class_action)d" class="oe_stat_button" icon="fa-address-book" type="action">
                    <div class="o_stat_info">
                        Class
                        <span class="o_stat_value">
                            <field name="class_count"/>
                        </span>
                    </div>
                </button>
            </div>
        </field>
    </record>
</odoo>