<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="ica_timetable_view_tree" model="ir.ui.view">
        <field name="name">ica_timetable_view_tree_view_tree</field>
        <field name="model">ica.timetable</field>
        <field name="arch" type="xml">
            <list string="ica_timetable_view_tree_tree"
                  decoration-success="state == 'finished'" decoration-danger="state == 'cancelled'">
                <field name="class_id"/>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="state" widget="badge" decoration-success="state == 'finished'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="ica_timetable_view_search" model="ir.ui.view">
        <field name="name">ica_timetable_view_search</field>
        <field name="model">ica.timetable</field>
        <field name="arch" type="xml">
            <search>
                <field name="class_id"/>
                <field name="state"/>
                <separator/>
                <filter name="filter_state_draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="filter_state_cancelled" string="Cancelled" domain="[('state','=','cancelled')]"/>
                <filter name="filter_state_finished" string="Finished" domain="[('state','=','finished')]"/>
                <group>
                    <filter name="group_by_class" context="{'group_by': 'class_id'}" string="Class"/>
                    <filter name="group_by_state" context="{'group_by': 'state'}" string="State"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ica_timetable_action" model="ir.actions.act_window">
        <field name="name">TimeTable</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ica.timetable</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_state_draft':1,'search_default_group_by_class':1}</field>
    </record>
</odoo>