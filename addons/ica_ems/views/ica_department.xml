<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="ica_department_view_tree" model="ir.ui.view">
        <field name="name">ica_department_view_tree_view_tree</field>
        <field name="model">ica.department</field>
        <field name="arch" type="xml">
            <list string="ica_department_view_tree_tree">
                <field name="name"/>
                <field name="university_id"/>
                <field name="parent_department_id"/>
            </list>
        </field>
    </record>

    <record id="ica_department_action" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ica.department</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>