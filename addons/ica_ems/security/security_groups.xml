<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record model="ir.module.category" id="module_ica_ems">
            <field name="name">Education Management System</field>
        </record>

        <record model="res.groups.privilege" id="res_groups_ica_ems">
            <field name="name">Levels</field>
            <field name="category_id" ref="ica_ems.module_ica_ems"/>
        </record>

        <record id="group_ica_basic_employee" model="res.groups">
            <field name="name">Employee</field>
            <field name="privilege_id" ref="ica_ems.res_groups_ica_ems"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_ica_manager_employee" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="ica_ems.res_groups_ica_ems"/>
            <field name="implied_ids" eval="[(4, ref('ica_ems.group_ica_basic_employee'))]"/>
        </record>

        <record id="group_ica_management_employee" model="res.groups">
            <field name="name">Management</field>
            <field name="privilege_id" ref="ica_ems.res_groups_ica_ems"/>
            <field name="implied_ids" eval="[(4, ref('ica_ems.group_ica_manager_employee'))]"/>
        </record>
    </data>
    <data noupdate="1">
        <record id="basic_employee_class_rule" model="ir.rule">
            <field name="name">basic_employee_class_rule</field>
            <field name="model_id" ref="ica_ems.model_ica_class"/>
            <field name="domain_force">[('employee_id', '=',user.employee_id.id)]</field>
            <field name="groups" eval="[(4, ref('ica_ems.group_ica_basic_employee'))]"/>
        </record>

        <record id="manager_class_rule" model="ir.rule">
            <field name="name">manager_class_rule</field>
            <field name="model_id" ref="ica_ems.model_ica_class"/>
            <field name="domain_force">[(1, '=',1)]</field>
            <field name="groups" eval="[(4, ref('ica_ems.group_ica_manager_employee'))]"/>
        </record>
    </data>
</odoo>