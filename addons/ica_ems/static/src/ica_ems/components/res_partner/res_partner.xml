<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="ica_ems.ResPartnerComponent">
       <div class="container mt-3">
        <h1>Res Partner</h1>
           <div class="d-flex">
               <input type="text" placeholder="Name" class="form-control mx-2" t-ref="search"/>
               <button t-on-click="searchPartners" class="btn btn-info">
                   <i class="fa fa-search"/></button>
           </div>
           <!--           <button t-on-click="fetchPartners">Fetch Partners</button>-->
           <div class="table table-responsive" style="max-height: 300px; overflow-y: auto;">
                      <table class="table">
              <thead>
                <tr>
                  <th scope="col">#</th>
                    <th scope="col">Display Name</th>
                    <th scope="col">Age</th>
                    <th scope="col">Date of Birth</th>
                </tr>
              </thead>
                          <tbody>
                   <t t-foreach="state.partners" t-as="partner" t-key="partner.id">
                       <tr>
                          <th scope="row">
                              <t t-esc="partner_index+1"/>
                          </th>
                           <td>
                               <t t-esc="partner.display_name"/>
                            </td>
                           <td>
                                <t t-if="partner.date_of_birth">
                                   <t t-esc="partner.age"/>
                               </t>
                               <t t-else="">
                                   -
                               </t>
                               <!--                               <t t-esc="partner.age"/>-->
                            </td>
                           <td>
                               <t t-if="partner.date_of_birth">
                                   <t t-esc="partner.date_of_birth"/>
                               </t>
                               <t t-else="">
                                   -
                               </t>
                            </td>
                        </tr>
                   </t>
              </tbody>
            </table>
        </div>
       </div>
    </t>
</templates>
