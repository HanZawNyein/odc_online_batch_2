<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="ica_ems.ResPartnerComponent">
       <div class="card m-3 p-5">
<!--        <h1>Res Partner</h1>-->
           <div class="d-flex">
               <input type="text" placeholder="Name" class="form-control mx-2" t-ref="search"/>
               <button t-on-click="searchPartners" class="btn btn-info"><i class="fa fa-search"/></button>
               <!-- Button trigger modal -->
               <button type="button" class="btn btn-primary mx-2" data-bs-toggle="modal"
                       data-bs-target="#staticBackdrop">
                  Create
                </button>
           </div>
           <!--           <button t-on-click="fetchPartners">Fetch Partners</button>-->
           <div class="table table-responsive" style="max-height: 300px; overflow-y: auto;">
                      <table class="table">
                        <thead style="position: sticky; top: 0; z-index: 2; background: #fff;" class="fw-bolder">
                            <tr>
                              <th scope="col">#</th>
                                <th scope="col">Display Name</th>
                                <th scope="col">Age</th>
                                <th scope="col">Date of Birth</th>
                                <th scope="col">Operations</th>
                            </tr>
                          </thead>
                          <tbody>
                           <t t-foreach="props.partners" t-as="partner" t-key="partner.id">
                               <tr>
                                  <th scope="row">
                                      <t t-esc="partner_index+1"/>
                                  </th>
                                   <td>
                                       <t t-esc="partner.display_name"/>(<t t-esc="partner.id"/>)
                                    </td>
                                   <td>
                                        <t t-if="partner.date_of_birth">
                                           <t t-esc="partner.age"/>
                                       </t>
                                       <t t-else="">
                                           -
                                       </t>
                                       <!--                               <t t-esc="partner.age"/>-->
                                    </td>
                                   <td>
                                       <t t-if="partner.date_of_birth">
                                           <t t-esc="partner.date_of_birth"/>
                                       </t>
                                       <t t-else="">
                                           -
                                       </t>
                                    </td>
                                   <td>
                                       <button type="button" class="btn btn-warning mx-2" data-bs-toggle="modal"
                                               data-bs-target="#staticBackdrop"
                                               t-on-click="()=>this.updatePartner(partner)">
                                      Update
                                    </button>
                                       <button class="btn btn-danger mx-2">Delete</button>
                                   </td>
                                </tr>
                           </t>
              </tbody>
            </table>
        </div>
       </div>

        <!-- Modal -->
        <div class="modal fade" id="staticBackdrop" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
             aria-labelledby="staticBackdropLabel" aria-hidden="true">
          <div class="modal-dialog">
            <div class="modal-content">
              <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">
                    <t t-if="state.currentPartner.id">
                        Update
                    </t>
                    <t t-else="">
                        Create
                    </t>

                </h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
              </div>
                <div class="modal-body">
                  <div class="mb-2">
                      <label for="name">Display Name</label>
                      <input id="name" class="form-control" type="text" placeholder="Display Name"
                             t-model="state.currentPartner.name"/>
                  </div>
                    <div class="mb-2">
                      <label for="date_of_birth">Date of Birth</label>
                        <input id="date_of_birth" class="form-control" type="date" placeholder="date_of_birth"
                               t-model="state.currentPartner.date_of_birth"/>
                  </div>
              </div>
                <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" t-on-click="removeCurrentPartner">Close</button>
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal" t-on-click="createPartner">Understood</button>
              </div>
            </div>
          </div>
        </div>
    </t>


</templates>
