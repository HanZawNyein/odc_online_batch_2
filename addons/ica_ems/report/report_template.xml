<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <template id="ica_layout">
<!--        <t t-call="web.html_container">-->
            <t t-if="not o" t-set="o" t-value="doc"/>
            <div class="container mt-2">
                <t t-out="0"/>
                <div class="mt-5">
                    <h1>I am Basic Layout</h1>
                    <h1>ကျွန်တော်ကတော့ အဂ္ဂပါ</h1>
                </div>
            </div>
<!--        </t>-->
    </template>

    <template id="ica_ems.report_ica_class">
        <t t-foreach="docs" t-as="o">
            <t t-call="web.html_container">
                <t t-call="web.basic_layout">
                    <div class="page">
                        <t t-call="ica_ems.ica_layout"/>
                        <h1>
                            <t t-esc="o.name"/>
                        </h1>
                        <table class="table">
                            <thead>
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">Time</th>
                                    <th scope="col">Last</th>
                                    <th scope="col">State</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.timetable_ids" t-as="timetable" t-key="timetable.id">
                                    <tr>
                                        <th scope="row">
                                            <t t-esc="timetable_index+1"/>4
                                        </th>
                                        <td>
                                            <t t-esc="timetable.start_datetime"/>
                                        </td>
                                        <td>
                                            <t t-esc="timetable.end_datetime"/>
                                        </td>
                                        <td>
                                            <t t-esc="timetable.state"/>
                                        </td>
                                    </tr>
                                </t>

                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
